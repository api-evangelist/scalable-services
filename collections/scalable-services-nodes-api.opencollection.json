{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kubernetes Core API (v1) ConfigMaps Nodes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/api/v1/nodes"
          },
          "docs": "List nodes"
        },
        {
          "info": {
            "name": "Read a node",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://kubernetes.default.svc/api/v1/nodes/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read a node"
        }
      ]
    }
  ],
  "bundled": true
}