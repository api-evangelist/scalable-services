{
  "example": {
    "title": "Kubernetes Horizontal Pod Autoscaler",
    "description": "Example Kubernetes HPA configuration for a scalable microservice.",
    "type": "kubernetes",
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "payment-service-hpa",
      "namespace": "production"
    },
    "spec": {
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "payment-service"
      },
      "minReplicas": 2,
      "maxReplicas": 20,
      "metrics": [
        {
          "type": "Resource",
          "resource": {
            "name": "cpu",
            "target": {
              "type": "Utilization",
              "averageUtilization": 70
            }
          }
        },
        {
          "type": "Resource",
          "resource": {
            "name": "memory",
            "target": {
              "type": "Utilization",
              "averageUtilization": 80
            }
          }
        }
      ]
    }
  }
}
